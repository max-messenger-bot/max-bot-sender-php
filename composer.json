{
    "name": "max-messenger-bot/max-bot-sender-php",
    "description": "PHP library for sending messages via the Max Messenger Bot API",
    "keywords": [
        "max",
        "messenger",
        "bot",
        "max messenger",
        "max bot",
        "notifications",
        "sender",
        "php"
    ],
    "type": "library",
    "license": "MIT",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "MaxMessenger\\Sender\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MaxMessenger\\Sender\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Eugene Makhaev",
            "email": "mj4444@mail.ru"
        }
    ],
    "support": {
        "email": "mj4444@mail.ru",
        "chat": "https://t.me/mj4444ru"
    },
    "require": {
        "php": "^7.4 || ^8.0",
        "ext-json": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "nyholm/psr7": "^1.8",
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.5",
        "psalm/plugin-phpunit": "^0.19",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "vimeo/psalm": "^6.16"
    },
    "suggest": {
        "ext-curl": "To send messages with the bundled CurlTransport; not needed with a PSR-18 client",
        "psr/http-client": "To send messages with PsrTransport through any PSR-18 client",
        "psr/http-factory": "To build PSR-7 requests in PsrTransport"
    },
    "scripts": {
        "cs": "php-cs-fixer check --diff",
        "cs-fix": "php-cs-fixer fix",
        "psalm": "psalm",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
